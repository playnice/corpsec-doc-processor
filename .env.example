# === Folder Paths ===
WATCH_FOLDER=C:\CorpSec\Inbox
PROCESSED_FOLDER=C:\CorpSec\Processed
ERROR_FOLDER=C:\CorpSec\Errors

# === Ollama Settings ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Vision model for scanned PDFs (bypasses Tesseract OCR)
# Options: llama3.2-vision, llama3.2-vision:90b, minicpm-v, gemma3:12b
OLLAMA_VISION_MODEL=llama3.2-vision

# === Teamwork Settings ===
TEAMWORK_BASE_URL=https://yourcompany.teamwork.com
TEAMWORK_API_KEY=your-api-key-here

# === Logging ===
LOG_LEVEL=INFO
